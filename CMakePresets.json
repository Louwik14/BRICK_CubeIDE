{
    "version": 3,
    "configurePresets": [
        {
            "name": "common-ninja-arm",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake"
        },
        {
            "name": "Debug",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "DebugDiag",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-g3",
                "CMAKE_CXX_FLAGS_DEBUG": "-g3"
            }
        },
        {
            "name": "Release",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Calibration32Chunk16",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BRICK6_STREAM_READ_CHUNK_KIB": "16"
            }
        },
        {
            "name": "Calibration32Chunk32",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BRICK6_STREAM_READ_CHUNK_KIB": "32"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "DebugDiag",
            "configurePreset": "DebugDiag"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Calibration32Chunk16",
            "configurePreset": "Calibration32Chunk16"
        },
        {
            "name": "Calibration32Chunk32",
            "configurePreset": "Calibration32Chunk32"
        }
    ]
}
