{
    "version": 3,
    "configurePresets": [
        {
            "name": "common-ninja-arm",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake"
        },
        {
            "name": "Debug",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BRICK6_VARIANT": "lowcost"
            }
        },
        {
            "name": "Release",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BRICK6_VARIANT": "lowcost"
            }
        },
        {
            "name": "Premium",
            "inherits": "common-ninja-arm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BRICK6_VARIANT": "premium"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Premium",
            "configurePreset": "Premium"
        }
    ]
}
